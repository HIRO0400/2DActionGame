  areas:
  - title: "A \u7A7A\u4E2D\u306B\u8DB3\u5834\u3092\u6B8B\u3059\u7DF4\u7FD2"
    instruction: "\u5730\u9762\u304B\u3089\u30B8\u30E3\u30F3\u30D7\u3057\u3066\u5DE6\u30AF\u30EA\u30C3\u30AF\u3092\u96E2\u3059\u3068\u3001\u305D\u306E\u9AD8\u3055\u306B\u8DB3\u5834\u304C\u6B8B\u308A\u307E\u3059\u3002\u307E\u305A\u5B89\u5168\u306A\u5E8A\u3067\u8A66\u3057\u307E\u3057\u3087\u3046\u3002"
    fromX: -8
    toX: 26
  - title: "B \u8DB3\u58341\u3064\u3067\u9AD8\u3044\u58C1\u3078"
    instruction: "\u58C1\u306E\u5C11\u3057\u624B\u524D\u3067\u3001\u7A7A\u4E2D\u306B\u8DB3\u5834\u30921\u3064\u6B8B\u3057\u307E\u3059\u3002\u5730\u9762\u3078\u623B\u308A\u3001\u305D\u306E\u8DB3\u5834\u306B\u4E57\u3063\u3066\u9577\u62BC\u3057\u30B8\u30E3\u30F3\u30D7\uFF01"
    fromX: 26
    toX: 62
  - title: "C \u7A74\u306E\u5F8C\u3067\u3001\u3082\u3046\u4E00\u5EA6"
    instruction: "\u7A74\u3092\u8D8A\u3048\u3066\u5B89\u5168\u306A\u5E8A\u306B\u7740\u5730\u3057\u3066\u304B\u3089\u8DB3\u5834\u3092\u8A2D\u7F6E\u3002\u5FC5\u8981\u306A\u306E\u306F\u4F7F\u3048\u308B\u8DB3\u58341\u3064\u3067\u3059\u3002"
    fromX: 62
    toX: 110
  - title: "D \u899A\u3048\u305F\u9AD8\u3055\u3092\u518D\u73FE"
    instruction: "\u6700\u5F8C\u306E\u9AD8\u3044\u58C1\u3082\u540C\u3058\u65B9\u6CD5\u3067\u653B\u7565\u3002\u30C8\u30B2\u306E\u624B\u524D\u306B\u306F\u5B89\u5168\u306A\u5E8A\u304C\u3042\u308A\u307E\u3059\u3002"
    fromX: 110
    toX: 150
  - title: "E \u7740\u5730\u3057\u3066\u30B4\u30FC\u30EB\u3078"
    instruction: "\u58C1\u3092\u8D8A\u3048\u305F\u3089\u3001\u6700\u5F8C\u306E\u898B\u3048\u308B\u30C8\u30B2\u3092\u9577\u62BC\u3057\u30B8\u30E3\u30F3\u30D7\u3067\u8D8A\u3048\u307E\u3057\u3087\u3046\u3002"
