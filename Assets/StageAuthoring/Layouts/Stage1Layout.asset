  - title: "B \u8DB3\u5834\u3092\u6B8B\u3057\u3066\u3001\u623B\u3063\u3066\u307F\u3088\u3046"
    instruction: "\u9AD8\u3044\u6BB5\u5DEE\u306E\u5C11\u3057\u624B\u524D\u3067\u5DE6\u30AF\u30EA\u30C3\u30AF\u3002\u96E2\u3059\u3068\u8DB3\u5834\u304C\u6B8B\u308A\u3001\u81EA\u5206\u306F\u623B\u308A\u307E\u3059\u3002\u6B8B\u3057\u305F\u8DB3\u5834\u306B\u4E57\u3063\u3066\u30B8\u30E3\u30F3\u30D7\uFF01"
    fromX: 12
    toX: 27
  - title: "C \u30B3\u30A4\u30F3\u3067\u8DB3\u5834\u3092\u5897\u3084\u305D\u3046"
    instruction: "\u30B3\u30A4\u30F3\u3092\u53D6\u308B\u3068\u6B8B\u305B\u308B\u8DB3\u5834\u304C1\u3064\u5897\u3048\u307E\u3059\u3002\u9AD8\u3044\u5834\u6240\u306E\u30B3\u30A4\u30F3\u306F\u3001\u53D6\u3089\u306A\u304F\u3066\u3082\u5148\u3078\u9032\u3081\u307E\u3059\u3002"
    fromX: 27
    toX: 40
  - title: "D \u5C0F\u3055\u306A\u7A74\u3092\u8D8A\u3048\u3088\u3046"
    instruction: "\u7A74\u306E\u5E95\u306B\u306F\u30C8\u30B2\u304C\u3042\u308A\u307E\u3059\u3002Space\u3092\u9577\u62BC\u3057\u3057\u3066\u30B8\u30E3\u30F3\u30D7\u3002\u7A7A\u4E2D\u306B\u3082\u30AF\u30ED\u30FC\u30F3\u306E\u8DB3\u5834\u3092\u6B8B\u305B\u307E\u3059\u3002"
    fromX: 40
    toX: 56
  - title: "E \u899A\u3048\u305F\u64CD\u4F5C\u3067\u3001\u30B4\u30FC\u30EB\u3078"
    instruction: "\u6700\u5F8C\u306E\u9AD8\u3044\u6BB5\u5DEE\u3082\u3001\u624B\u524D\u306B\u6B8B\u3057\u305F\u8DB3\u5834\u3092\u4F7F\u3063\u3066\u8D8A\u3048\u307E\u3057\u3087\u3046\u3002\u30B3\u30A4\u30F3\u3067\u5897\u3048\u305F\u8DB3\u5834\u6570\u3082\u4F7F\u3048\u307E\u3059\u3002"
